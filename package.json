{
  "name": "vue-timer-hook",
  "type": "module",
  "version": "1.0.111",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "timer",
    "hook"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/vue-timer-hook.d.ts",
      "import": "./dist/vue-timer-hook.esm-bundler.js",
      "require": "./dist/vue-timer-hook.cjs"
    }
  },
  "main": "dist/vue-timer-hook.cjs",
  "module": "dist/vue-timer-hook.esm-bundler.js",
  "unpkg": "dist/vue-timer-hook.global.js",
  "jsdelivr": "dist/vue-timer-hook.global.js",
  "types": "dist/vue-timer-hook.d.ts",
  "files": [
    "README.md",
    "dist/*.cjs",
    "dist/*.js",
    "dist/vue-timer-hook.d.ts",
    "vetur/attributes.json",
    "vetur/tags.json"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.js && tsc -p tsconfig.build.json",
    "build:dts": "api-extractor run --local --verbose",
    "dev": "vite --config demo/vite.config.js",
    "release": "bash scripts/release.sh",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 1",
    "build:demo": "vue-tsc --noEmit && vite build --config demo/vite.config.js",
    "deploy:demo": "bun run build:demo && node scripts/deploy.js",
    "build:size": "bun run build && rollup -c size-checks/rollup.config.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:types": "tsc --build tsconfig.json",
    "test:dts": "tsc -p ./test-dts/tsconfig.json",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:ui": "vitest --ui",
    "test": "bun run test:types && bun run test:unit",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "verify:build": "bun run build && bun run build:dts && bun run test:dist",
    "prepare": "husky install"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "vetur": {
    "tags": "vetur/tags.json",
    "attributes": "vetur/attributes.json"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@microsoft/api-extractor": "^7.59.4",
    "@rollup/plugin-alias": "^6.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "^5.0.5",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/server-renderer": "^3.5.44",
    "@vue/test-utils": "^2.5.1",
    "ajv": "^8.20.0",
    "brotli": "^2.1.0",
    "chalk": "^6.0.1",
    "conventional-changelog-cli": "^5.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.13.0",
    "eslint-plugin-format": "^2.0.1",
    "faked-promise": "^2.2.2",
    "gh-pages": "^6.3.0",
    "highlight.js": "^11.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "mockdate": "^3.0.5",
    "rollup": "^4.65.0",
    "rollup-plugin-analyzer": "^4.0.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13",
    "yorkie": "^2.0.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue}": [
      "eslint --fix"
    ]
  }
}
